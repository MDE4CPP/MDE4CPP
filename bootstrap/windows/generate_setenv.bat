@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "SCRIPT_DIR=%~dp0"
call "%~dp0common.bat"

for %%I in ("%SCRIPT_DIR%\..\..") do set "REPO_ROOT=%%~fI"

call "%~dp0common.bat" print_header "generate_setenv" "Running Setenv Generator..."

if not defined PROJECT_DIR set "PROJECT_DIR=%REPO_ROOT%"
if not defined SETENV_FILE set "SETENV_FILE=%REPO_ROOT%\setenv.bat"

set "HAS_CUSTOM_ECLIPSE=0"
if not "!MDE4CPP_ECLIPSE_LOCATION!"=="" (
    set "ECLIPSE_DIR=!MDE4CPP_ECLIPSE_LOCATION!"
    set "HAS_CUSTOM_ECLIPSE=1"
) else if not defined ECLIPSE_DIR (
    set "ECLIPSE_DIR=%REPO_ROOT%\..\eclipse"
)

echo %C_PURPLE%[generate_setenv]%C_WARN% Generating %SETENV_FILE%...%C_RESET%

(
    echo @echo off
    echo REM ########################################
    echo REM # Environment configuration of MDE4CPP #
    echo REM # Generated by generate_setenv.bat     #
    echo REM ########################################
    echo.
    echo REM Set MDE4CPP project directory dynamically from current folder
    echo set "MDE4CPP_HOME=%%CD%%"
    if "!HAS_CUSTOM_ECLIPSE!"=="1" (
        echo set "MDE4CPP_ECLIPSE_HOME=!ECLIPSE_DIR!"
    ) else (
        echo set "MDE4CPP_ECLIPSE_HOME=%%MDE4CPP_HOME%%\..\eclipse"
    )
    echo.
    echo REM Dynamically discovered JAVA_HOME
    echo set "JAVA_HOME=%JAVA_HOME%"
    echo.
    echo REM Set compiler home directory
    if not defined COMPILER_HOME set "COMPILER_HOME=C:\tools\MinGW"
    echo set "COMPILER_HOME=!COMPILER_HOME!"
    echo.
    echo REM Set CMake home directory
    if not defined CMAKE_HOME set "CMAKE_HOME=C:\Program Files\CMake"
    echo set "CMAKE_HOME=!CMAKE_HOME!"
    echo.
    echo REM Update PATH variable locally
    echo if defined CMAKE_HOME set "PATH=%%CMAKE_HOME%%\bin;%%PATH%%"
    echo set "PATH=%%MDE4CPP_HOME%%\application\bin;%%MDE4CPP_HOME%%\application\tools;%%PATH%%"
    echo if defined JAVA_HOME set "PATH=%%JAVA_HOME%%\bin;%%PATH%%"
    echo if defined COMPILER_HOME set "PATH=%%PATH%%;%%COMPILER_HOME%%\bin"
    echo.
    echo REM configure Gradle tasks and compiling processes
    if not defined GRADLE_PARALLEL set "GRADLE_PARALLEL=true"
    echo set "GRADLE_OPTS=-Dorg.gradle.parallel=!GRADLE_PARALLEL!"
    if not defined WORKER_COUNT set "WORKER_COUNT=4"
    echo set "ORG_GRADLE_PROJECT_WORKER=!WORKER_COUNT!"
    echo set "ORG_GRADLE_PROJECT_RELEASE=1"
    echo set "ORG_GRADLE_PROJECT_DEBUG=0"
    echo set "ORG_GRADLE_PROJECT_DEBUG_MESSAGE_FUML=0"
    echo.
    echo REM Configure JAVA CLASSPATH
    echo set "CLASSPATH=%%MDE4CPP_ECLIPSE_HOME%%\plugins"
    echo.
    echo REM Configure compiler delivery name
    echo set "COMPILER_DELIVERY_NAME=x86_64-w64-mingw32"
    echo.
    echo REM Set C++ IDE Executable for Gradle task
    echo set "CPP_IDE_EXECUTABLE=%%MDE4CPP_ECLIPSE_HOME%%"
) > "%SETENV_FILE%"

echo %C_PURPLE%[generate_setenv]%C_SUCCESS% setenv.bat generated successfully.%C_RESET%
exit /b 0
