@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ########################################
REM # Windows Bootstrap script for MDE4CPP #
REM ########################################

set "DIR=%~dp0"
set "PROJECT_DIR=%~dp0"
REM Remove trailing slash for PROJECT_DIR
if "%PROJECT_DIR:~-1%"=="\" set "PROJECT_DIR=%PROJECT_DIR:~0,-1%"

for %%I in ("%PROJECT_DIR%\..") do set "PARENT_DIR=%%~fI"
set "ECLIPSE_DIR=%PARENT_DIR%\eclipse"
set "SETENV_FILE=%PROJECT_DIR%\setenv.bat"

echo ===========================================================
echo MDE4CPP Bootstrap Script for Windows
echo ===========================================================

echo Generating %SETENV_FILE%...
(
    echo @echo off
    echo REM ########################################
    echo REM # Environment configuration of MDE4CPP #
    echo REM # Generated by bootstrap.bat           #
    echo REM ########################################
    echo.
    echo REM Set MDE4CPP project and eclipse directories
    echo set "MDE4CPP_HOME=%PROJECT_DIR%"
    echo set "MDE4CPP_ECLIPSE_HOME=%ECLIPSE_DIR%"
    echo.
    echo REM Set compiler home directory
    echo set COMPILER_HOME=C:\tools\MinGW
    echo.
    echo REM Update PATH variable locally
    echo set "PATH=%%COMPILER_HOME%%\bin;%%MDE4CPP_HOME%%\application\bin;%%MDE4CPP_HOME%%\application\tools;%%PATH%%"
    echo.
    echo REM configure Gradle tasks and compiling processes
    echo set "GRADLE_OPTS=-Dorg.gradle.parallel=true"
    echo set "ORG_GRADLE_PROJECT_WORKER=1"
    echo set "ORG_GRADLE_PROJECT_RELEASE=1"
    echo set "ORG_GRADLE_PROJECT_DEBUG=1"
    echo set "ORG_GRADLE_PROJECT_DEBUG_MESSAGE_FUML=0"
    echo.
    echo REM Configure JAVA CLASSPATH
    echo set "CLASSPATH=%%MDE4CPP_ECLIPSE_HOME%%\plugins"
    echo.
    echo REM Configure compiler delivery name
    echo set "COMPILER_DELIVERY_NAME=x86_64-w64-mingw32"
    echo.
    echo REM Set C++ IDE Executable for Gradle task
    echo set "CPP_IDE_EXECUTABLE=%%MDE4CPP_ECLIPSE_HOME%%"
) > "%SETENV_FILE%"

echo ===========================================================
echo Installing system tools...
echo ===========================================================

call "%DIR%bootstrap\Windows\installJava.bat"
if errorlevel 1 (
    echo ERROR: installJava.bat failed ^(exit !errorlevel!^)
    exit /b !errorlevel!
)

call "%DIR%bootstrap\Windows\installCompiler.bat"
if errorlevel 1 (
    echo ERROR: installCompiler.bat failed ^(exit !errorlevel!^)
    exit /b !errorlevel!
)

call "%DIR%bootstrap\Windows\installCMake.bat"
if errorlevel 1 (
    echo ERROR: installCMake.bat failed ^(exit !errorlevel!^)
    exit /b !errorlevel!
)

call "%DIR%bootstrap\Windows\installEclipse.bat"
if errorlevel 1 (
    echo ERROR: installEclipse.bat failed ^(exit !errorlevel!^)
    exit /b !errorlevel!
)

echo ===========================================================
echo Resolving JAVA_HOME...
echo ===========================================================

REM Reload PATH from system registry since installers modify it in a separate elevated process
for /f "tokens=2*" %%A in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment" /v Path 2^>nul ^| findstr /I "Path"') do set "SYS_PATH=%%B"
for /f "tokens=2*" %%A in ('reg query "HKCU\Environment" /v Path 2^>nul ^| findstr /I "Path"') do set "USR_PATH=%%B"
if defined SYS_PATH set "PATH=!SYS_PATH!;!USR_PATH!;%PATH%"

REM Read JAVA_HOME from system registry (winget sets this here)
if "!JAVA_HOME!"=="" (
    for /f "tokens=2*" %%A in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment" /v JAVA_HOME 2^>nul ^| findstr /I "JAVA_HOME"') do (
        if exist "%%B\bin\java.exe" (
            set "JAVA_HOME=%%B"
            echo [bootstrap] Loaded JAVA_HOME from system registry: !JAVA_HOME!
        )
    )
)

REM Fallback: Scan common JDK 21 installation directories
if "!JAVA_HOME!"=="" (
    for /d %%I in ("%ProgramFiles%\Microsoft\jdk-21*") do (
        if exist "%%~fI\bin\java.exe" set "JAVA_HOME=%%~fI"
    )
)
if "!JAVA_HOME!"=="" (
    for /d %%I in ("%ProgramFiles%\Eclipse Adoptium\jdk-21*") do (
        if exist "%%~fI\bin\java.exe" set "JAVA_HOME=%%~fI"
    )
)
if "!JAVA_HOME!"=="" (
    for /d %%I in ("%ProgramFiles%\Java\jdk-21*") do (
        if exist "%%~fI\bin\java.exe" set "JAVA_HOME=%%~fI"
    )
)

if not "!JAVA_HOME!"=="" (
    echo [bootstrap] Using JAVA_HOME=!JAVA_HOME!
    (
        echo.
        echo REM Dynamically discovered JAVA_HOME
        echo set "JAVA_HOME=!JAVA_HOME!"
        echo set "PATH=%%JAVA_HOME%%\bin;%%PATH%%"
    ) >> "%SETENV_FILE%"
) else (
    echo [bootstrap] ERROR: Could not find Java 21.
    echo [bootstrap] --- Diagnostics ---
    echo [bootstrap] ProgramFiles=%ProgramFiles%
    echo [bootstrap] Registry JAVA_HOME:
    reg query "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment" /v JAVA_HOME 2>nul
    if errorlevel 1 echo [bootstrap]   ^(not set^)
    echo [bootstrap] Contents of "%ProgramFiles%\Microsoft":
    if exist "%ProgramFiles%\Microsoft" (
        dir /b /ad "%ProgramFiles%\Microsoft" 2>nul | findstr /I "jdk"
        if errorlevel 1 echo [bootstrap]   ^(no jdk directories^)
    ) else (
        echo [bootstrap]   ^(directory does not exist^)
    )
    echo [bootstrap] --- End diagnostics ---
    exit /b 1
)

echo ===========================================================
echo Running Gradle install to download third-party dependencies...
echo ===========================================================

call "%SETENV_FILE%"

cd /D "%PROJECT_DIR%"
set "GRADLE_WRAPPER=%PROJECT_DIR%\application\tools\gradlew.bat"
if exist "%GRADLE_WRAPPER%" (
    call "%GRADLE_WRAPPER%" install --no-daemon
    if errorlevel 1 (
        echo ERROR: Gradle install task failed ^(exit !errorlevel!^)
        exit /b !errorlevel!
    )
) else (
    echo ERROR: Gradle wrapper not found at %GRADLE_WRAPPER%
    exit /b 1
)

echo ===========================================================
echo Bootstrap completed successfully!
echo To activate the environment, please run:
echo   call setenv.bat
echo ===========================================================

endlocal
