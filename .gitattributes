# -----------------------------------------------------------------------------
# Handle line endings
# @see https://help.github.com/en/github/using-git/configuring-git-to-handle-line-endings
#
# At best, configure your Git globally:
#
#   GNU/Linux & macOS : git config --global core.autocrlf input
#   Microsoft Windows : git config --global core.autocrlf true
#
# -----------------------------------------------------------------------------

# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicit normalized and converted file types to native line endings on checkout
*.bat text eol=crlf

*.gradle text=lf

*.java text=lf
*.mtl text=lf
*.c text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
setenv text eol=lf
setenv.* text eol=lf

# Ensure all text files use LF
* text=auto eol=auto

# Explicit format of line endings on checkout
*.sln text eol=crlf
# Force LF line endings for shell scripts and Dockerfiles
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
docker/Dockerfile text eol=lf
