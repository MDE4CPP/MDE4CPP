# Secure Terminal Container Image
# This container is used for isolated terminal execution
# It has minimal dependencies and runs as non-root user

FROM ubuntu:22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal required packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    findutils \
    grep \
    sed \
    gawk \
    curl \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN useradd -u 1000 -m -s /bin/bash terminal && \
    mkdir -p /workspace && \
    chown terminal:terminal /workspace

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER terminal

# Default command (keeps container running)
CMD ["/bin/bash"]
