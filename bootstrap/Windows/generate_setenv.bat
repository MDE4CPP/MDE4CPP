@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "SCRIPT_DIR=%~dp0"
call "%SCRIPT_DIR%..\common.bat" load_properties

for %%I in ("%SCRIPT_DIR%\..\..") do set "REPO_ROOT=%%~fI"

if not defined PROJECT_DIR set "PROJECT_DIR=%REPO_ROOT%"
if not defined SETENV_FILE set "SETENV_FILE=%REPO_ROOT%\setenv.bat"
if not defined ECLIPSE_DIR set "ECLIPSE_DIR=%REPO_ROOT%\eclipse"

echo ===========================================================
echo Generating %SETENV_FILE%...
echo ===========================================================

(
    echo @echo off
    echo REM ########################################
    echo REM # Environment configuration of MDE4CPP #
    echo REM # Generated by generate_setenv.bat     #
    echo REM ########################################
    echo.
    echo REM Set MDE4CPP project and eclipse directories
    echo set "MDE4CPP_HOME=%PROJECT_DIR%"
    echo set "MDE4CPP_ECLIPSE_HOME=%ECLIPSE_DIR%"
    echo.
    echo REM Dynamically discovered JAVA_HOME
    echo set "JAVA_HOME=%JAVA_HOME%"
    echo.
    echo REM Set compiler home directory
    echo set COMPILER_HOME=C:\tools\MinGW
    echo.
    echo REM Update PATH variable locally
    echo set "PATH=%%JAVA_HOME%%\bin;%%COMPILER_HOME%%\bin;%%MDE4CPP_HOME%%\application\bin;%%MDE4CPP_HOME%%\application\tools;%%PATH%%"
    echo.
    echo REM configure Gradle tasks and compiling processes
    if not defined GRADLE_PARALLEL set "GRADLE_PARALLEL=true"
    echo set "GRADLE_OPTS=-Dorg.gradle.parallel=%GRADLE_PARALLEL%"
    if not defined WORKER_COUNT set "WORKER_COUNT=1"
    echo set "ORG_GRADLE_PROJECT_WORKER=%WORKER_COUNT%"
    echo set "ORG_GRADLE_PROJECT_RELEASE=1"
    echo set "ORG_GRADLE_PROJECT_DEBUG=1"
    echo set "ORG_GRADLE_PROJECT_DEBUG_MESSAGE_FUML=0"
    echo.
    echo REM Configure JAVA CLASSPATH
    echo set "CLASSPATH=%%MDE4CPP_ECLIPSE_HOME%%\plugins"
    echo.
    echo REM Configure compiler delivery name
    echo set "COMPILER_DELIVERY_NAME=x86_64-w64-mingw32"
    echo.
    echo REM Set C++ IDE Executable for Gradle task
    echo set "CPP_IDE_EXECUTABLE=%%MDE4CPP_ECLIPSE_HOME%%"
) > "%SETENV_FILE%"

echo [bootstrap] setenv.bat generated successfully.
exit /b 0
